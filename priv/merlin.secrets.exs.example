# merlin secrets. Copy to merlin.secrets.exs beside merlin.exs and
#
#     chmod 600 merlin.secrets.exs
#     chown merlin:merlin merlin.secrets.exs
#
# The daemon REFUSES TO START if this file is readable by group or other. That
# check runs before the file is evaluated.
#
# Nothing here belongs in merlin.exs. The point of the split is that merlin.exs
# is a document about your house that you can read to someone; config.toml in
# the Python held the client secret and the Discord webhook inline, so it could
# not be shown, copied or pasted anywhere.

%{
  # HAPN vehicle tracker, OAuth2 client credentials.
  hapn_auth_endpoint: "https://REPLACE/oauth/token",
  hapn_device_endpoint: "https://REPLACE/devices/REPLACE",
  hapn_client_id: "REPLACE",
  hapn_client_secret: "REPLACE",

  # Weather.
  weather_endpoint: "https://REPLACE/v1/current",
  weather_api_key: "REPLACE",

  # Discord webhook. Note the daemon treats a 404 from this URL as permanent:
  # deleting a webhook is how Discord revokes it.
  discord_webhook: "https://discord.com/api/webhooks/REPLACE/REPLACE"
}
