#!/bin/sh
#
# PROVIDE: merlin_ex
# REQUIRE: LOGIN mosquitto
# KEYWORD: shutdown
#
# The Elixir merlin. Installed as /usr/local/etc/rc.d/merlin-ex, deliberately
# beside the Python's /usr/local/etc/rc.d/merlin rather than replacing it, so
# that both exist and exactly one is enabled at a time.

. /etc/rc.subr

name="merlin_ex"
rcvar="merlin_ex_enable"

load_rc_config $name

: ${merlin_ex_enable:="NO"}
: ${merlin_ex_user:="merlin"}
: ${merlin_ex_root:="/usr/local/merlin-ex/current"}
: ${merlin_ex_config:="/usr/local/etc/merlin/merlin.exs"}
: ${merlin_ex_state:="/var/db/merlin"}

pidfile="/var/run/${name}.pid"
procname="${merlin_ex_root}/erts-*/bin/beam.smp"

command="/usr/sbin/daemon"

# `start`, in the FOREGROUND, under daemon(8) -- not `bin/merlin daemon`.
#
# The release's own `daemon` verb detaches via run_erl, which would leave
# daemon(8) supervising a process that exits immediately: -R 5 would then
# restart it forever and the pidfile would name something that is not the VM.
# One supervisor, and it is this one.
command_args="-f -R 5 -S -T ${name} -P ${pidfile} ${merlin_ex_root}/bin/merlin start"

start_precmd="merlin_ex_precmd"
stop_cmd="merlin_ex_stop"
status_cmd="merlin_ex_status"

merlin_ex_precmd()
{
	# Preflight, as the merlin user, before anything starts. It validates the
	# config, resolves every secret, opens the database, connects to the
	# broker and binds the ports.
	#
	# Without this a bad config is a restart loop under -R 5 while you read
	# logs to work out why; with it, `service merlin-ex start` prints the
	# reason and returns non-zero.
	export MERLIN_CONFIG="${merlin_ex_config}"
	export MERLIN_STATE_DIR="${merlin_ex_state}"

	if ! su -m "${merlin_ex_user}" -c "MERLIN_CONFIG='${merlin_ex_config}' MERLIN_STATE_DIR='${merlin_ex_state}' ${merlin_ex_root}/bin/merlin-preflight"; then
		err 1 "preflight failed; refusing to start merlin-ex"
	fi
}

merlin_ex_stop()
{
	# Through the release, so terminate/2 runs and the fact snapshot is
	# written. A signal to daemon(8) would take the VM down without it and
	# lose up to one snapshot interval of latch state.
	if [ -x "${merlin_ex_root}/bin/merlin" ]; then
		echo "Stopping ${name}."
		su -m "${merlin_ex_user}" -c "MERLIN_STATE_DIR='${merlin_ex_state}' ${merlin_ex_root}/bin/merlin stop" || true
	fi

	# daemon(8) exits once its child does; clean up if it did not.
	if [ -f "${pidfile}" ]; then
		pkill -F "${pidfile}" 2>/dev/null || true
		rm -f "${pidfile}"
	fi
}

merlin_ex_status()
{
	if [ -x "${merlin_ex_root}/bin/merlin" ]; then
		su -m "${merlin_ex_user}" -c "MERLIN_STATE_DIR='${merlin_ex_state}' ${merlin_ex_root}/bin/merlin pid" >/dev/null 2>&1 &&
			echo "${name} is running." ||
			echo "${name} is not running."
	else
		echo "${name} is not installed at ${merlin_ex_root}."
	fi
}

run_rc_command "$1"
