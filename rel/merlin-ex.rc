#!/bin/sh
#
# PROVIDE: merlin_ex
# REQUIRE: LOGIN mosquitto
# KEYWORD: shutdown
#
# The Elixir merlin. Installed as /usr/local/etc/rc.d/merlin-ex, deliberately
# beside the Python's /usr/local/etc/rc.d/merlin rather than replacing it, so
# that both exist and exactly one is enabled at a time.

. /etc/rc.subr

name="merlin_ex"
rcvar="merlin_ex_enable"

load_rc_config $name

: ${merlin_ex_enable:="NO"}
: ${merlin_ex_runas:="merlin"}
: ${merlin_ex_root:="/usr/local/merlin-ex/current"}
: ${merlin_ex_config:="/usr/local/etc/merlin/merlin.exs"}
: ${merlin_ex_state:="/var/db/merlin"}

pidfile="/var/run/${name}.pid"

# The working directory, and it matters.
#
# `su -m` preserves ROOT's environment including HOME=/root, which the merlin
# user cannot write. The BEAM needs a writable working directory -- it is
# where erl_crash.dump goes, among other things -- and without one it dies
# during boot with a badarg deep inside the logger that names nothing useful.
# Found by doing exactly that by hand.
merlin_ex_chdir="${merlin_ex_state}"
procname="${merlin_ex_root}/erts-*/bin/beam.smp"

command="/usr/sbin/daemon"

# `start`, in the FOREGROUND, under daemon(8) -- not `bin/merlin daemon`.
#
# The release's own `daemon` verb detaches via run_erl, which would leave
# daemon(8) supervising a process that exits immediately: -R 5 would then
# restart it forever and the pidfile would name something that is not the VM.
# One supervisor, and it is this one.
# `-u` so daemon(8) itself runs as root -- it has to, to write a pidfile in
# /var/run -- and drops to the merlin user for the child.
#
# NOT `${name}_user`: rc.subr treats that as "su the whole command", which
# runs daemon(8) as merlin and fails with `ppidfile: Permission denied`
# before the daemon is ever started.
command_args="-f -u ${merlin_ex_runas} -R 5 -S -T ${name} -P ${pidfile} ${merlin_ex_root}/bin/merlin start"

# HOME too: daemon(8) runs the command with rc's environment, and the release
# scripts consult it.
merlin_ex_env="HOME=${merlin_ex_state} MERLIN_CONFIG=${merlin_ex_config} MERLIN_STATE_DIR=${merlin_ex_state}"

start_precmd="merlin_ex_precmd"
stop_cmd="merlin_ex_stop"
status_cmd="merlin_ex_status"

merlin_ex_precmd()
{
	# Preflight, as the merlin user, before anything starts. It validates the
	# config, resolves every secret, opens the database, connects to the
	# broker and binds the ports.
	#
	# Without this a bad config is a restart loop under -R 5 while you read
	# logs to work out why; with it, `service merlin-ex start` prints the
	# reason and returns non-zero.
	export MERLIN_CONFIG="${merlin_ex_config}"
	export MERLIN_STATE_DIR="${merlin_ex_state}"

	_env="MERLIN_CONFIG='${merlin_ex_config}' MERLIN_STATE_DIR='${merlin_ex_state}' HOME='${merlin_ex_state}'"

	if ! su -m "${merlin_ex_runas}" -c "cd '${merlin_ex_state}' && ${_env} ${merlin_ex_root}/bin/merlin-preflight"; then
		err 1 "preflight failed; refusing to start merlin-ex"
	fi
}

merlin_ex_stop()
{
	# Through the release, so terminate/2 runs and the fact snapshot is
	# written. A signal to daemon(8) would take the VM down without it and
	# lose up to one snapshot interval of latch state.
	if [ -x "${merlin_ex_root}/bin/merlin" ]; then
		echo "Stopping ${name}."
		su -m "${merlin_ex_runas}" -c "cd '${merlin_ex_state}' && MERLIN_STATE_DIR='${merlin_ex_state}' HOME='${merlin_ex_state}' ${merlin_ex_root}/bin/merlin stop" || true
	fi

	# daemon(8) exits once its child does; clean up if it did not.
	if [ -f "${pidfile}" ]; then
		pkill -F "${pidfile}" 2>/dev/null || true
		rm -f "${pidfile}"
	fi
}

merlin_ex_status()
{
	if [ -x "${merlin_ex_root}/bin/merlin" ]; then
		su -m "${merlin_ex_runas}" -c "cd '${merlin_ex_state}' && MERLIN_STATE_DIR='${merlin_ex_state}' HOME='${merlin_ex_state}' ${merlin_ex_root}/bin/merlin pid" >/dev/null 2>&1 &&
			echo "${name} is running." ||
			echo "${name} is not running."
	else
		echo "${name} is not installed at ${merlin_ex_root}."
	fi
}

run_rc_command "$1"
