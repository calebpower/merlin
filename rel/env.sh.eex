#!/bin/sh
# Release environment. Written into the release by `mix release`.

# The default RELEASE_TMP is $RELEASE_ROOT/tmp, and the install tree is
# root-owned -- an unprivileged daemon cannot write there. This is the single
# most common reason a FreeBSD release starts as root in testing and then
# fails to start as its own user in production.
export RELEASE_TMP="${MERLIN_STATE_DIR:-/var/db/merlin}/tmp"
export HOME="${MERLIN_STATE_DIR:-/var/db/merlin}"

export MERLIN_CONFIG="${MERLIN_CONFIG:-/usr/local/etc/merlin/merlin.exs}"
export MERLIN_STATE_DIR="${MERLIN_STATE_DIR:-/var/db/merlin}"

# Distribution bound to loopback. A remote IEx into a misbehaving home daemon
# is worth a great deal; exposing epmd to the LAN is not.
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="merlind@127.0.0.1"
export ERL_EPMD_ADDRESS=127.0.0.1
