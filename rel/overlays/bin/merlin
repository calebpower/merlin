#!/bin/sh
#
# merlin: the operator interface.
#
# With no arguments this opens the terminal UI; with any, it answers and exits.
# The shape `screen` has, and for the same reason -- "the thing I run" and "the
# thing I script" being two different names is a distinction nobody remembers
# at 3am.
#
# The UI runs in its OWN beam, not in the daemon. `eval` boots a separate VM
# with the release's code loaded and no application started, which is exactly
# what a client wants: the daemon's schedulers are not shared with a render
# loop, System.halt/1 cannot reach the house, and a TUI bug is fixed by running
# a new client rather than by restarting a daemon that runs in embedded mode.
set -eu

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)

MERLIN_ARGV=$(printf '%s\n' "$@")
export MERLIN_ARGV

# The terminal size, read HERE, because here is where the terminal is.
#
# The client runs under `merlind eval`, and inside that VM both probes in
# Merlin.TUI.Term.size/0 fail: `stty -f /dev/tty size` and `tput` each come
# back empty, so it fell through to its 80x24 default and drew an 80-column
# frame in the corner of whatever window you actually had. On a 40-row
# terminal the help overlay rendered 24 rows tall and put half of itself below
# the fold.
#
# This shell does have the terminal. Term.size/0's third fallback is COLUMNS
# and LINES -- a path that already existed and was never reachable, because
# nothing ever set them. `stty size` reports rows first, which is the opposite
# order to everything else here and is exactly the transposition that produces
# a frame nobody can explain.
#
# Both paths get this, one-shot included: `merlin --once` in a bug report
# should be the frame the reporter was looking at.
if _size=$(stty size 2>/dev/null); then
    _rows=${_size%% *}
    _cols=${_size##* }
    # "0 0" is what a pty with no controlling terminal answers. Passing that on
    # would ask for a zero-column grid; leaving it unset lets Term decide.
    if [ "${_rows:-0}" -gt 0 ] 2>/dev/null && [ "${_cols:-0}" -gt 0 ] 2>/dev/null; then
        LINES=$_rows
        COLUMNS=$_cols
        export LINES COLUMNS
    fi
    unset _size _rows _cols
fi

# One-shot commands never touch the tty, so they take the simple path and may
# exec: there is nothing to restore afterwards.
case "${1:-}" in
    key|preflight|help|--help|-h|--version|--once)
        exec "$SCRIPT_DIR/merlind" eval 'Merlin.CLI.run()'
        ;;
esac

# From here on the terminal is ours, and giving it back is not optional.
#
# The trap must outlive the program, so this deliberately does NOT exec: exec
# replaces this shell and takes the trap with it, and a TUI that dies badly
# would then leave the operator in raw mode with no echo and no cursor -- a
# shell that still works and looks broken, which is the worst outcome here.
#
# restore runs on every path: normal exit, Ctrl-C, SIGTERM, and a dropped SSH
# session (HUP). It is idempotent, so the loop's own restore doing it first
# costs nothing.
saved=$(stty -g)

restore() {
    stty "$saved" 2>/dev/null || true
    # Reset attributes, show the cursor, leave the alternate screen. Written
    # here as well as in Merlin.TUI.Render because this has to work when no
    # Elixir ran at all -- a VM that failed to boot still leaves a terminal.
    printf '\033[0m\033[?25h\033[?1049l'
}

trap restore EXIT INT TERM HUP
stty raw -echo

status=0
"$SCRIPT_DIR/merlind" eval 'Merlin.CLI.run()' || status=$?

restore
exit "$status"
