#!/bin/sh
# Key management. Works whether or not the daemon is running: `eval` boots a
# separate BEAM, and SQLite in WAL mode allows both to hold the file.
#
# Arguments travel in the environment, one per line, rather than being
# interpolated into the eval expression. `bin/merlin eval` takes an expression
# and does NOT populate System.argv() from trailing shell arguments, and
# building the expression by string interpolation would mean quoting user
# input into code -- which is exactly the shape of mistake worth refusing to
# make in a script that handles credentials.
set -eu
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
MERLIN_ARGV=$(printf '%s\n' "$@")
export MERLIN_ARGV
exec "$SCRIPT_DIR/merlin" eval 'Merlin.CLI.main(:key, Merlin.CLI.argv())'
